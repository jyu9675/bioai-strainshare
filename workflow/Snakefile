# ============================================================================
# M6 — portable Snakemake workflow  [SCAFFOLD]
# ============================================================================
# Wraps the numbered scripts into a reproducible DAG so any cohort runs with one
# `snakemake` invocation. Heavy rules (map/profile/compare/metaphlan) need the Unix
# `bioai` conda env; the analysis rules are pure-Python and cross-platform.
#
# This is a scaffold: it encodes the intended dependency graph. Fill sample wiring
# (SAMPLES from metadata) before production use.
#
#   snakemake -j8 --use-conda           # dry-run first with -n
# ----------------------------------------------------------------------------
configfile: "workflow/config.yaml"   # points at data/refs/results paths + strainshare_standard.yaml

RESULTS = config.get("results_dir", "results")

rule all:
    input:
        f"{RESULTS}/direction_calls.tsv",
        f"{RESULTS}/genome_generalist_flags.tsv",
        f"{RESULTS}/figures/fig1_within_vs_between.png",

# --- heavy, Unix-only (profiles -> compare -> metaphlan) are shelled out to the
#     existing numbered scripts to avoid duplicating tested logic ---
rule compare:
    output: f"{RESULTS}/compare.IS/output/genomeWide_compare.tsv"
    params: prof=f"{RESULTS}/profiles", refs=config["refs_dir"], threads=config.get("threads", 8)
    shell:  "bash scripts/04_compare.sh {params.prof} {params.refs} {RESULTS}/compare.IS {params.threads}"

rule metaphlan:
    output: f"{RESULTS}/metaphlan/merged_metaphlan.tsv"
    params: data=config["fastq_dir"], threads=config.get("threads", 8)
    shell:  "bash scripts/07_metaphlan.sh {params.data} {RESULTS}/metaphlan {params.threads}"

# --- analysis half: config-driven, cross-platform ---
rule analysis:
    input:
        compare=rules.compare.output,
        mpa=rules.metaphlan.output,
        meta=config["metadata"],
    output:
        f"{RESULTS}/direction_calls.tsv",
        f"{RESULTS}/genome_generalist_flags.tsv",
        f"{RESULTS}/figures/fig1_within_vs_between.png",
    shell:
        "python scripts/strainshare.py --compare {input.compare} --meta {input.meta} "
        "--metaphlan {input.mpa} --outdir " + RESULTS
