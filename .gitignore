# ============================================================
# BIOAI — keep the code + small examples, ignore runtime blobs
# ============================================================

# ---- runtime dirs: regenerated by the pipeline, can be huge ----
data/*
results/*
refs/*
# ...but keep the folders and their explainers on GitHub
!data/.gitkeep
!data/README.md
!results/.gitkeep
!results/README.md
!refs/.gitkeep
!refs/README.md
# (example/ is intentionally committed — it is NOT one of the runtime dirs)

# ---- sequence / alignment / reference blobs anywhere ----
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bam.bai
*.bai
*.sam
*.cram
*.fna
*.fa
*.fasta
*.fai
*.gz
# bowtie2 index + inStrain profile outputs
*.bt2
*.bt2l
*.IS
*.IS/
*.stb

# ---- python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
env/

# ---- workflow / conda scratch ----
.snakemake/
bioai_tmp/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# python build
*.egg-info/
build/
dist/
.pytest_cache/
